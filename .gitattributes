# 统一换行：仓库内规范化为 LF，检出时按平台自动处理
* text=auto

# ---------- 二进制文件（显式声明，避免被当作文本转换而损坏）----------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.keras  binary
*.h5     binary
*.npy    binary
*.npz    binary
*.docx   binary
*.xlsx   binary
*.pptx   binary
*.zip    binary

# ---------- 文本文件 ----------
*.py     text
*.md     text
*.txt    text
*.json   text
*.cff    text
*.yml    text
*.yaml   text
*.csv    text

# ---------- 统计口径 ----------
# 数据集与训练产物为批量生成的二进制文件，不计入语言统计
simulation-dataset/outputs/dataset/pom_images/**  linguist-generated=true
simulation-dataset/outputs/visualizations/**      linguist-generated=true
cnn-inversion/runs/**                             linguist-generated=true
paper/**                                          linguist-vendored=true

# ---------- 差异展示 ----------
*.keras  diff=astextplain
*.pdf    diff=astextplain
